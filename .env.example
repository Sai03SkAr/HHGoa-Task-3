# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored - never commit real values.
# The pipeline runs fully with ALL of these blank (local chain + Mastodon).
# ---------------------------------------------------------------------------

# --- Chain -----------------------------------------------------------------
# local | amoy | sepolia | base-sepolia
CHAIN=local
# Burner key ONLY. Never a wallet holding real funds. Generate with:
#   python -m src.cli wallet-new
PRIVATE_KEY=
# Address of the deployed EvidenceRegistry (printed by the deploy step)
CONTRACT_ADDRESS=
# Override the built-in RPC for the selected chain if you need to
RPC_URL=

# --- Search ----------------------------------------------------------------
# Mastodon instance queried first by the default (zero-key) provider.
MASTODON_INSTANCE=https://mastodon.social
# Further instances tried in order if the first returns nothing or fails.
# Each has its own federated view, so these are different sources, not retries.
MASTODON_FALLBACKS=https://mstdn.social,https://mas.to

# NOTE: reverse image search (SerpAPI Google Lens) is NOT implemented. It would
# require publishing the probe face to a public URL, which contradicts this
# project's privacy stance - see docs/DECISIONS.md D-003 and D-015.

# --- Face ------------------------------------------------------------------
# Cosine similarity bar for "same person". See docs/DECISIONS.md D-011.
MATCH_THRESHOLD=0.45
